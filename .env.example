# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- LLM provider (OpenAI-compatible) ---------------------------------------
# One key for whichever provider you use. Default below targets OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# To switch providers, replace the two lines above with one of these sets:
#   Groq (free tier):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# --- Scheduler --------------------------------------------------------------
# Heartbeat in seconds
TICK_INTERVAL=5
